DATABASE_URL="mysql://root:root@localhost:3308/help"

DATABASE_USER="root"
DATABASE_PASSWORD="root"
DATABASE_NAME="help"
DATABASE_HOST="localhost"
DATABASE_PORT=3308

# ms-auth-java (Spring Boot). From the host: http://localhost:8080 ;
# from the compose `gateway` container: http://app:8080 (set by docker-compose.dev.yml)
MS_AUTH_URL="http://localhost:8080"

# Access tokens are issued by ms-auth-java: this MUST be the exact same Base64 value as
# ms-auth-java's JWT_SECRET (the Gateway only verifies, it never signs).
JWT_ACCESS_SECRET="<same-base64-value-as-ms-auth-java-JWT_SECRET>"
JWTALGORITHM="HS256"

FRONTEND_URL="http://localhost:5173"

# https://myprojects.geoapify.com/
GEOAPIFY_API_KEY="<your-geoapify-api-key>"

# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="<your-google-oauth-client-id>"
